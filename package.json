{
  "name": "runner-sandbox",
  "description": "runner-sandbox workspace",
  "version": "0.0.1",
  "scripts": {
    "sync": "akan sync",
    "dev": "akan start",
    "lint": "akan lint",
    "typecheck": "akan typecheck",
    "test": "akan test",
    "build": "akan build",
    "setup:agent": "akan agent install all --force",
    "agent:setup": "akan agent install all --force",
    "agent:doctor": "akan doctor --strict --format json",
    "agent:context": "akan context --format json",
    "agent:mcp:readonly": "akan mcp-install all --mode readonly --force",
    "agent:mcp:plan": "akan mcp-install all --mode plan --force",
    "agent:mcp:apply": "akan mcp-install all --mode apply --force",
    "agent:workflows": "akan workflow list",
    "agent:sample:context": "akan context --format markdown --app sandbox --module project",
    "agent:sample:service": "akan create-service billing sandbox --format json",
    "agent:sample:module": "akan create-module project sandbox --page=true --format json",
    "agent:sample:field": "akan add-field --app sandbox --module project --field budget --type Int --default 0 --format json",
    "agent:sample:status": "akan add-enum-field --app sandbox --module project --field status --values draft,active,archived --default draft --format json",
    "agent:sample:sync": "akan sync sandbox",
    "agent:sample:check": "akan doctor --strict --format json",
    "agent:sample:workflow:explain": "akan workflow explain add-field",
    "agent:sample:workflow:plan": "akan workflow plan add-field --app sandbox --module task --field priority --type enum --values low,medium,high --default medium --format json --out .akan/workflows/plans/task-priority.json",
    "agent:sample:workflow:dry-run": "akan workflow apply .akan/workflows/plans/task-priority.json --dry-run --format json"
  },
  "dependencies": {
    "@react-spring/web": "^10.1.2",
    "@use-gesture/react": "^10.3.1",
    "chance": "^1.1.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "react-refresh": "^0.19.0",
    "react-server-dom-webpack": "19.3.1",
    "react-spring": "^10.0.4",
    "scheduler": "^0.28.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "akanjs": "3.1.1-rc.4"
  },
  "devDependencies": {
    "@akanjs/cli": "3.1.1-rc.4",
    "@akanjs/devkit": "3.1.1-rc.4",
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  },
  "patchedDependencies": {}
}
